# 複製為 .env 後填寫；.env 已被 gitignore。此檔只放「範例值」，不得放真實資料。
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL_LIVE=qwen2.5:7b-instruct
LLM_MODEL_REVIEW=gemma4:12b
STT_URL=http://127.0.0.1:8001
VOICEVOX_URL=http://127.0.0.1:50021
# 私人資料（履歷、JD）放在 repo 之外的資料夾：
PRIVATE_DATA_DIR=C:/path/outside/repo/interview-private

# === 外部 LLM API Keys（選填；未填寫時自動以純本地 Ollama 運行）===
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# === 混搭梯隊與每日預算上限（USD）===
LLM_TIER1_MODEL=
LLM_TIER2_MODEL=
LLM_TIER3_MODEL=
DAILY_BUDGET_USD=1.0
